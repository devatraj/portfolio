---
import Base from '../layouts/Base.astro';
import Kundli from '../components/Kundli.astro';
import Gochar from '../components/Gochar.astro';
import { profile, factById, orgLabel } from '../lib/profile.js';

const { person: p, capabilities: caps, education: edu, roles, principles, path, skills } = profile;

const TICKER = [
  ['$115K', 'a year saved by replacing two paid services'],
  ['10M+', 'requests a day on a platform I built'],
  ['85%', 'of LLM calls served from my semantic cache'],
  ['500K+', 'users connected by my Kafka matching engine'],
  ['35%', 'more conversions from one LLM feature'],
  ['1851', 'peak LeetCode rating, Knight'],
  ['200+', 'student developers led at GDSC'],
];

// Tech stack as three orbits. Every name must exist in profile.skills.
const ORBITS = [
  ['LangGraph', 'RAG', 'MCP', 'LangChain'],
  ['Java', 'Spring Boot', 'Python', 'FastAPI', 'Kafka'],
  ['Redis', 'MongoDB', 'Kubernetes', 'Docker', 'GCP', 'React'],
];
const allSkills = Object.values(skills).flat();
for (const s of ORBITS.flat()) {
  if (!allSkills.some((x) => x === s || x.startsWith(`${s} `))) throw new Error(`Orbit skill not in profile.yaml: ${s}`);
}

// Selected work. Each gets a constellation generated from its id, so the preview is stable.
const SELECTED = ['milansathi', 'firebase-replacement', 'chat-suggestions', 'semantic-cache', 'ai-code-reviewer', 'resume-tailor'];
function constellation(id) {
  let h = 2166136261;
  for (const c of id) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  const rnd = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0) / 4294967296);
  const pts = Array.from({ length: 6 + Math.floor(rnd() * 3) }, () => [18 + rnd() * 204, 18 + rnd() * 104]);
  // Greedy nearest-neighbour path, so the lines read as one figure.
  const left = pts.slice(1), order = [pts[0]];
  while (left.length) {
    const [lx, ly] = order.at(-1);
    let bi = 0;
    left.forEach(([x, y], i) => { if ((x - lx) ** 2 + (y - ly) ** 2 < (left[bi][0] - lx) ** 2 + (left[bi][1] - ly) ** 2) bi = i; });
    order.push(left.splice(bi, 1)[0]);
  }
  return { pts: order.map(([x, y]) => [Math.round(x), Math.round(y)]), d: order.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(0)} ${y.toFixed(0)}`).join(' ') };
}
const work = SELECTED.map((id, i) => {
  const f = factById[id];
  return {
    n: String(i + 1).padStart(2, '0'), id, title: f.title, credit: f.credit,
    org: orgLabel(f) === f.title ? 'Jeevansathi' : orgLabel(f),
    line: f.plain ?? f.text, metric: f.metrics?.[0], href: id === 'milansathi' ? '/work/milansathi/' : `/work/#${id}`,
    sky: constellation(id),
  };
});

const DOORS = [
  { who: 'Hiring?', what: 'Experience, education and how I work.', href: '/about/', cta: 'About me' },
  { who: 'Have a project?', what: 'AI agents and tools that replace paid services or manual work.', href: '/can/agents-tools/', cta: 'Agents & tools' },
  { who: 'Student or engineer?', what: 'How I went from 1,200+ DSA problems to production systems.', href: '/about/#path', cta: 'My path' },
];
const ASK = ['What has he built with LLMs?', 'How did he prove milanSathi was correct?', 'Is he open to relocating?'];
const rule = principles.find((r) => r.title.startsWith('Prove')) ?? principles[0];
---
<Base title={`${p.name}: Backend & AI engineer`} description="I build AI systems that replace what companies pay for. About $115,000 a year saved so far." page="home">
  <div class="planets-bg" aria-hidden="true" data-planets>
    <div class="h-body h-moon" data-speed="0.06"><canvas data-sphere="moon" data-tex="512" data-moon-live></canvas></div>
    <div class="h-body h-saturn" data-speed="0.1"><canvas data-sphere="saturn" data-tex="512" data-spin="0.03" data-roll="-18" data-tilt="0.34"></canvas></div>
    <div class="h-body h-jupiter" data-speed="0.15"><canvas data-sphere="jupiter" data-tex="512" data-spin="0.05" data-roll="-4"></canvas></div>
  </div>

  <section class="hero" data-hero>
    <div class="scene" aria-hidden="true">
      <div class="asteroid a1"><canvas data-rock="7" width="120" height="120"></canvas></div>
      <div class="asteroid a2"><canvas data-rock="19" width="80" height="80"></canvas></div>
      <div class="ring" data-depth="0.18"></div>
      <svg class="ridge r1" data-depth="0.32" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 230 L120 170 L210 200 L330 120 L420 175 L540 95 L660 180 L760 140 L880 205 L1010 110 L1120 170 L1240 125 L1340 185 L1440 150 V320 H0Z" /></svg>
      <svg class="ridge r2" data-depth="0.22" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 250 L90 215 L200 245 L300 190 L410 235 L520 175 L640 230 L760 200 L860 250 L980 185 L1100 235 L1210 205 L1330 245 L1440 215 V320 H0Z" /></svg>
      <svg class="ridge r3" data-depth="0.1" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 280 C180 250 300 270 460 262 C640 252 760 286 940 272 C1100 260 1260 282 1440 266 V320 H0Z" /></svg>
    </div>

    <div class="wrap hero-in">
      <div class="intro">
        <div class="hello" data-reveal>
          {p.photo
            ? <img class="avatar" src={p.photo} alt={p.name} width="52" height="52" />
            : <span class="avatar ph" aria-hidden="true">DB</span>}
          <p>Hi, I'm Devatraj. Backend &amp; AI engineer at Info Edge.</p>
        </div>
        <h1 data-reveal>I build AI systems that <em>replace</em> what companies pay for.</h1>
        <p class="sub" data-reveal>I turn expensive vendors, slow AI features and fragile backends into systems your team owns, and I prove they work before anything switches over.</p>
        <div class="ctas" data-reveal>
          <a class="btn solid" href="#can">See what I can do</a>
          <button type="button" class="btn ask-btn" data-ask-open>Ask the stars about me</button>
        </div>
      </div>
      <Kundli />
    </div>
    <a class="cue" href="#chart" aria-label="Scroll to the next section"><span></span></a>
  </section>

  <div class="ticker" aria-label="At a glance">
    <ul class="track">
      {[0, 1].map((copy) => TICKER.map(([n, t]) => (
        <li aria-hidden={copy ? 'true' : undefined}><b class="num">{n}</b><span>{t}</span><i aria-hidden="true">✦</i></li>
      )))}
    </ul>
  </div>

  <section class="section wrap" id="chart">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Birth chart</p>
      <h2>The short version.</h2>
    </div>
    <div class="bento">
      <article class="tile t-self" data-spot data-reveal>
        <p class="tile-k">Ascendant · who I am</p>
        <p class="big">Backend &amp; AI engineer who replaces paid vendors with systems teams own.</p>
        <p class="dim">{roles[0].title}, {roles[0].org} since {roles[0].dates.split(' ')[0]}. Before that, {roles[1].title.toLowerCase()} at {roles[1].org.split('· ')[1]}.</p>
        <a class="go" href="/about/">More about me</a>
      </article>

      <article class="tile t-now" data-spot data-reveal>
        <p class="tile-k">Right now in {p.location.split(',')[0]}</p>
        <div class="now">
          <div>
            <p class="clock num" data-clock>--:--</p>
            <p class="dim small-t" data-date>India Standard Time</p>
          </div>
          <div class="moon-wrap">
            <canvas class="moon" data-sphere="moon" data-tex="512" data-moon-live aria-hidden="true"></canvas>
            <p class="dim small-t" data-moon-name>Tonight's moon</p>
          </div>
        </div>
        <p class="dim small-t">Open to relocating to {p.relocation}.</p>
      </article>

      <article class="tile t-edu" data-spot data-reveal>
        <p class="tile-k">Foundations</p>
        <p class="stat num" data-count>{edu.cgpa.split(' ')[0]}</p>
        <p class="dim small-t">CGPA out of 10, B.Tech CSE at NIT Patna</p>
      </article>

      <article class="tile t-cp" data-spot data-reveal>
        <p class="tile-k">Competition</p>
        <p class="stat num" data-count>1851</p>
        <p class="dim small-t">peak LeetCode rating, Knight, top 5%</p>
      </article>

      <article class="tile t-orbit" data-reveal>
        <p class="tile-k">The planets I work with</p>
        <div class="orbits" aria-label={`Tech stack: ${ORBITS.flat().join(', ')}`} role="img">
          <div class="sun" aria-hidden="true">
            <svg viewBox="0 0 40 40"><rect x="2" y="2" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" /><path d="M2 2 L38 38 M38 2 L2 38 M20 2 L38 20 L20 38 L2 20 Z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </div>
          {ORBITS.map((ring, ri) => (
            <div class={`orbit o${ri + 1}`} aria-hidden="true">
              {ring.map((s, i) => (
                <span class="planet-l" style={`--a: ${(360 / ring.length) * i + ri * 23}deg`}><span class="arm"><b>{s}</b></span></span>
              ))}
            </div>
          ))}
        </div>
      </article>

      <article class="tile t-rule" data-spot data-reveal>
        <p class="tile-k">How I work</p>
        <p class="quote">“{rule.title}.”</p>
        <p class="dim">{rule.text}</p>
      </article>

      <article class="tile t-mail" data-reveal>
        <p class="tile-k">Say hello</p>
        <button type="button" class="copy" data-copy={p.email}>
          <span class="addr">{p.email}</span>
          <span class="copy-s" data-copy-label>Copy email</span>
        </button>
      </article>
    </div>
  </section>

  <Gochar />

  <section class="section wrap" id="can">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Houses of work</p>
      <h2>What I can do for you</h2>
      <p>Five things I'm good at. Each page has a small tool you can try and the work that proves it. Explore all five to fill the diamonds in the header.</p>
    </div>
    <div class="caps">
      {caps.map((c) => (
        <a class="cap" href={`/can/${c.slug}/`} data-visited={c.slug} data-spot data-reveal>
          <span class="cap-metric"><b class="num">{c.headline_metric[0]}</b> {c.headline_metric[1]}</span>
          <h3>{c.title}</h3>
          <p class="dim">{c.promise}</p>
          <span class="go">Explore <i class="seen">Explored</i></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="work">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Constellations</p>
      <h2>Selected work</h2>
      <p>Six projects I'd show first. Every one has numbers you can check.</p>
    </div>
    <ol class="work" data-work>
      {work.map((w) => (
        <li data-reveal>
          <a href={w.href} data-preview={w.id}>
            <span class="w-n num">{w.n}</span>
            <span class="w-main">
              <span class="w-org">{w.org}{w.credit === 'Contributed' && ', team project'}</span>
              <span class="w-t">{w.title}</span>
              <span class="w-line dim">{w.line}</span>
            </span>
            {w.metric && <span class="w-m">{w.metric}</span>}
            <span class="w-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <a class="btn all" href="/work/">All 18 projects</a>
    <div class="peek" aria-hidden="true" data-peek>
      {work.map((w) => (
        <figure data-peek-id={w.id}>
          <svg viewBox="0 0 240 140">
            <path d={w.sky.d} class="c-line" />
            {w.sky.pts.map(([x, y], i) => <circle cx={x} cy={y} r={i === 0 ? 3.4 : 2.2} class="c-star" style={`--i:${i}`} />)}
          </svg>
          <figcaption><b>{w.metric ?? w.title}</b></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section wrap" id="path">
    <div class="transits">
      <div class="t-side" data-reveal>
        <p class="eyebrow">Transits</p>
        <h2>From DSA to production</h2>
        <p class="dim">How I got here, for students and engineers who ask. Scroll and the path fills in.</p>
        <p class="year num" data-year aria-hidden="true">{path[0].when}</p>
      </div>
      <ol class="path" data-timeline>
        {path.map((s) => <li data-when={s.when}><span class="when num">{s.when}</span><span class="what">{s.what}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section wrap" id="ask">
    <div class="ask-card" data-reveal>
      <div>
        <p class="eyebrow">Ask the stars</p>
        <h2>Ask anything about my work.</h2>
        <p class="dim">An AI that answers only from the facts on this site, cites where each answer comes from, and says so when it doesn't know.</p>
      </div>
      <div class="ask-qs">
        {ASK.map((q) => <button type="button" data-ask-open data-ask-q={q}>{q}<span aria-hidden="true">↗</span></button>)}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head" data-reveal><h2>Start where it makes sense for you</h2></div>
    <div class="doors">
      {DOORS.map((d) => (
        <a class="door" href={d.href} data-spot data-reveal>
          <h3>{d.who}</h3>
          <p class="dim">{d.what}</p>
          <span class="go">{d.cta}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  import { moonPhase } from '../lib/astro.js';
  import { mountAll } from '../lib/spheres.js';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Parallax: scenery layers sink at their own depth as the hero scrolls away.
  const layers = [...document.querySelectorAll<HTMLElement>('[data-depth]')];
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  if (!reduce && layers.length) {
    let ticking = false;
    const paint = () => {
      ticking = false;
      const y = Math.min(scrollY, hero.offsetHeight);
      layers.forEach((l) => (l.style.transform = `translate3d(0, ${y * +l.dataset.depth!}px, 0)`));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } }, { passive: true });
    paint();
  }

  // Background planets: fixed to the window, drifting up at a fraction of the scroll speed
  // (each its own, for depth), and dimming once the hero is behind you so text stays clear.
  {
    const bg = document.querySelector<HTMLElement>('[data-planets]')!;
    const bodies = [...bg.querySelectorAll<HTMLElement>('[data-speed]')];
    let ticking = false;
    const paint = () => {
      ticking = false;
      const y = Math.min(scrollY, innerHeight * 2);
      if (!reduce) bodies.forEach((b) => (b.style.transform = `translate3d(0, ${-y * +b.dataset.speed!}px, 0)`));
      bg.style.opacity = String(1 - 0.5 * Math.min(1, scrollY / innerHeight));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } }, { passive: true });
    paint();
  }

  // Live IST clock and tonight's moon phase (synodic month from a known new moon).
  const clock = document.querySelector('[data-clock]')!;
  const date = document.querySelector('[data-date]')!;
  const tick = () => {
    const now = new Date();
    clock.textContent = now.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: false });
    date.textContent = `${now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'long', day: 'numeric', month: 'short' })}, IST`;
  };
  tick();
  setInterval(tick, 15_000);
  // Tonight's moon, from the Sun-Moon elongation (src/lib/astro.js): drawn lit at its real phase.
  {
    const { phase, lit } = moonPhase();
    const names = ['New moon', 'Waxing crescent', 'First quarter', 'Waxing gibbous', 'Full moon', 'Waning gibbous', 'Last quarter', 'Waning crescent'];
    document.querySelector('[data-moon-name]')!.textContent = `${names[Math.round(phase * 8) % 8]}, ${Math.round(lit * 100)}% lit`;
    document.querySelectorAll<HTMLCanvasElement>('[data-moon-live]').forEach((c) => (c.dataset.phase = String(phase)));
    mountAll();
  }

  // Asteroids: an irregular lumpy rock, lit from the upper left, with a few craters. Drawn once;
  // CSS drifts and tumbles it across the hero.
  document.querySelectorAll<HTMLCanvasElement>('[data-rock]').forEach((c) => {
    let seed = +c.dataset.rock!;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const g = c.getContext('2d')!, W = c.width, R = W * 0.36, n = 26;
    const k = Array.from({ length: 5 }, () => [rnd() * 6.28, 0.04 + rnd() * 0.09, 1 + Math.floor(rnd() * 4)]);
    g.translate(W / 2, W / 2);
    g.beginPath();
    for (let i = 0; i <= n; i++) {
      const a = (i / n) * Math.PI * 2;
      const r = R * (0.8 + k.reduce((s, [ph, amp, f]) => s + amp * Math.sin(a * f + ph), 0));
      i ? g.lineTo(Math.cos(a) * r, Math.sin(a) * r) : g.moveTo(Math.cos(a) * r, Math.sin(a) * r);
    }
    g.closePath();
    const fill = g.createRadialGradient(-R * 0.4, -R * 0.45, R * 0.1, 0, 0, R * 1.2);
    fill.addColorStop(0, '#b7a593'); fill.addColorStop(0.45, '#6f6155'); fill.addColorStop(1, '#1d1a22');
    g.fillStyle = fill; g.fill();
    g.save(); g.clip();
    for (let i = 0; i < 7; i++) {
      const x = (rnd() - 0.5) * R * 1.4, y = (rnd() - 0.5) * R * 1.4, cr = R * (0.08 + rnd() * 0.16);
      g.beginPath(); g.arc(x, y, cr, 0, Math.PI * 2); g.fillStyle = 'rgba(20,16,22,0.38)'; g.fill();
      g.beginPath(); g.arc(x - cr * 0.18, y - cr * 0.18, cr, Math.PI * 0.9, Math.PI * 1.6); g.strokeStyle = 'rgba(230,214,196,0.28)'; g.lineWidth = 1.2; g.stroke();
    }
    g.restore();
  });

  // Copy email.
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const label = b.querySelector('[data-copy-label]')!;
    try { await navigator.clipboard.writeText(b.dataset.copy!); label.textContent = 'Copied ✓'; }
    catch { location.href = `mailto:${b.dataset.copy}`; return; }
    b.classList.add('done');
    setTimeout(() => { label.textContent = 'Copy email'; b.classList.remove('done'); }, 2200);
  }));

  // Selected work: a constellation card that follows the pointer.
  const peek = document.querySelector<HTMLElement>('[data-peek]')!;
  {
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const follow = () => {
      x += (tx - x) * 0.18; y += (ty - y) * 0.18;
      peek.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((a) => {
      a.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        peek.querySelectorAll('figure').forEach((f) => f.classList.toggle('on', f.dataset.peekId === a.dataset.preview));
        if (!peek.classList.contains('show')) { x = tx = e.clientX + 24; y = ty = e.clientY - 80; }
        peek.classList.add('show');
      });
      a.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        tx = e.clientX + 24; ty = e.clientY - 80;
        if (!raf) raf = requestAnimationFrame(follow);
      });
      a.addEventListener('pointerleave', () => peek.classList.remove('show'));
    });
  }

  // Transits: the big year follows the milestone nearest the reading line.
  const year = document.querySelector('[data-year]')!;
  const stops = [...document.querySelectorAll<HTMLElement>('[data-when]')];
  addEventListener('scroll', () => {
    let cur = stops[0];
    for (const s of stops) if (s.getBoundingClientRect().top < innerHeight * 0.6) cur = s;
    if (year.textContent !== cur.dataset.when) year.textContent = cur.dataset.when!;
  }, { passive: true });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: 100svh; margin-top: -76px; padding-top: 76px; display: grid; align-content: center; overflow: clip; }
  .scene { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .scene > * { position: absolute; will-change: transform; }
  .h-body canvas, .asteroid canvas { display: block; width: 100%; height: 100%; }
  /* Background planets live in the window, not the page, so every screen size sees all three. */
  .planets-bg { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .planets-bg .h-body { position: absolute; aspect-ratio: 1; will-change: transform; }
  .h-moon { width: clamp(90px, 9vw, 130px); top: max(88px, 10vh); left: 41vw; filter: drop-shadow(0 0 34px rgb(255 241 201 / 0.28)); }
  .h-saturn { width: clamp(130px, 13vw, 200px); top: max(70px, 8vh); left: 1.5vw; filter: drop-shadow(0 0 30px rgb(233 214 166 / 0.18)); }
  .h-jupiter { width: clamp(60px, 6vw, 96px); bottom: 12vh; right: 1.5vw; filter: drop-shadow(0 0 24px rgb(215 167 124 / 0.25)); }
  .asteroid { width: 52px; aspect-ratio: 1; top: 0; left: 0; opacity: 0.9; offset-rotate: 0deg; }
  .asteroid canvas { animation: tumble 19s linear infinite; }
  .a1 { animation: drift-a 70s linear infinite; animation-delay: -12s; }
  .a2 { width: 30px; animation: drift-b 95s linear infinite; animation-delay: -50s; opacity: 0.75; }
  .a2 canvas { animation-duration: 13s; animation-direction: reverse; }
  @keyframes tumble { to { rotate: 360deg; } }
  @keyframes drift-a { from { translate: 108vw 6vh; } to { translate: -12vw 78vh; } }
  @keyframes drift-b { from { translate: -10vw 30vh; } to { translate: 110vw 4vh; } }
  .ring {
    width: clamp(380px, 52vw, 760px); aspect-ratio: 1; right: -12%; top: -14%; border-radius: 50%;
    border: 1px dashed rgb(242 181 68 / 0.16);
    background: radial-gradient(closest-side, transparent 64%, rgb(242 181 68 / 0.04) 65%, transparent 66%, transparent 83%, rgb(111 211 197 / 0.05) 84%, transparent 85%);
    animation: zodiac 140s linear infinite;
  }
  @keyframes zodiac { to { rotate: 360deg; } }
  .ridge { left: 0; width: 100%; bottom: 0; height: clamp(160px, 26vh, 300px); }
  .r1 path { fill: #141a45; }
  .r2 path { fill: #10153a; }
  .r3 path { fill: var(--night); }
  .r1 { filter: drop-shadow(0 -10px 30px rgb(98 70 190 / 0.25)); }
