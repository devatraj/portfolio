---
import { profile, factById, ordinal } from '../lib/profile.js';

// North-Indian chart on a 400×400 square. House 1 is the top diamond, then anticlockwise.
const A = [0, 0], B = [400, 0], C = [400, 400], D = [0, 400];
const T = [200, 0], R = [400, 200], Bm = [200, 400], L = [0, 200], O = [200, 200];
const P1 = [100, 100], P2 = [300, 100], P3 = [300, 300], P4 = [100, 300];

const SHAPES = {
  1: { pts: [T, P2, O, P1], at: [200, 100] },
  2: { pts: [A, T, P1], at: [100, 34] },
  3: { pts: [A, P1, L], at: [36, 100] },
  4: { pts: [L, P1, O, P4], at: [100, 200] },
  5: { pts: [L, P4, D], at: [36, 300] },
  6: { pts: [D, P4, Bm], at: [100, 368] },
  7: { pts: [Bm, P4, O, P3], at: [200, 300] },
  8: { pts: [Bm, P3, C], at: [300, 368] },
  9: { pts: [C, P3, R], at: [364, 300] },
  10: { pts: [R, P3, O, P2], at: [300, 200] },
  11: { pts: [R, P2, B], at: [364, 100] },
  12: { pts: [B, P2, T], at: [300, 34] },
};

// Two balanced lines so labels fit the narrow triangles.
function lines(label) {
  const w = label.split(' ');
  if (w.length === 1) return [label];
  let best = [label], score = Infinity;
  for (let i = 1; i < w.length; i++) {
    const a = w.slice(0, i).join(' '), b = w.slice(i).join(' ');
    const s = Math.max(a.length, b.length);
    if (s < score) { score = s; best = [a, b]; }
  }
  return best;
}

const houses = profile.kundli.map((h) => {
  const f = h.fact && factById[h.fact];
  return {
    ...h,
    ...SHAPES[h.house],
    lines: lines(h.label),
    body: f ? `The ${ordinal(h.house)} house is ${h.meaning.toLowerCase()}. ${f.plain ?? f.text}` : h.note,
    metrics: f?.metrics ?? [],
  };
});
const poly = (pts) => pts.map((p) => p.join(',')).join(' ');
---
<figure class="kundli" data-kundli>
  <div class="chart">
    <svg viewBox="-22 -6 444 412" role="group" aria-label="My career drawn as a kundli chart. Click a house to read it.">
      <defs>
        <radialGradient id="glow" cx="50%" cy="50%" r="55%">
          <stop offset="0" stop-color="#f2b544" stop-opacity="0.08" />
          <stop offset="1" stop-color="#f2b544" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect x="0" y="0" width="400" height="400" class="paper" />
      <rect x="0" y="0" width="400" height="400" fill="url(#glow)" />
      {houses.map((h) => (
        <g class="house" data-house={h.house} tabindex="0" role="button" aria-label={`${ordinal(h.house)} house, ${h.meaning}: ${h.label}`}>
          <polygon points={poly(h.pts)} />
          <text x={h.at[0]} y={h.at[1] - (h.lines.length - 1) * 8 - 10} class="hn">{h.house}</text>
          {h.lines.map((ln, i) => (
            <text x={h.at[0]} y={h.at[1] + 7 + i * 16 - (h.lines.length - 1) * 8} class="hl">{ln}</text>
          ))}
        </g>
      ))}
      <g class="ink" aria-hidden="true">
        <rect x="0" y="0" width="400" height="400" pathLength="1" />
        <path d="M0 0 L400 400" pathLength="1" />
        <path d="M400 0 L0 400" pathLength="1" />
        <path d="M200 0 L400 200 L200 400 L0 200 Z" pathLength="1" />
      </g>
    </svg>
  </div>

  <figcaption class="reading">
    <div class="stack" aria-live="polite">
    {houses.map((h, i) => (
      <div class:list={['read', { on: i === 1 }]} data-house={h.house} aria-hidden={i === 1 ? 'false' : 'true'}>
        <p class="which"><span class="num">{ordinal(h.house)}</span> house, {h.meaning.toLowerCase()}</p>
        <p class="body">{h.body}</p>
        {h.metrics.length > 0 && (
          <ul class="m num">{h.metrics.map((m) => <li>{m}</li>)}</ul>
        )}
      </div>
    ))}
    </div>
    <div class="progress">
      <p class="hint dim" data-hint>My career, drawn as a kundli. Click a house to read it.</p>
      <ol class="pips" aria-hidden="true">{houses.map((h) => <li data-pip={h.house}></li>)}</ol>
      <p class="count dim"><span class="num" data-read>0</span> of 12 houses read</p>
    </div>
    <div class="done" hidden data-done>
      <p><b>You've read the whole chart.</b> That makes you more thorough than most interviewers. Let's talk.</p>
      <a class="btn solid" href={`mailto:${profile.person.email}?subject=I%20read%20the%20whole%20chart`}>Email me</a>
    </div>
  </figcaption>
</figure>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-kundli]');
    const houses = [...root.querySelectorAll('.house')];
    const reads = [...root.querySelectorAll('.read')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 2, timer = null;
    const read = new Set();

    // Only houses a person picks count toward the 12, not the automatic walk.
    function mark(n) {
      if (read.has(n)) return;
      read.add(n);
      root.querySelector(`[data-pip="${n}"]`).classList.add('lit');
      root.querySelector('[data-read]').textContent = read.size;
      if (read.size === 12) {
        root.classList.add('complete');
        root.querySelector('[data-done]').hidden = false;
      }
    }

    function show(n) {
      current = n;
      houses.forEach((g) => g.classList.toggle('on', +g.dataset.house === n));
      reads.forEach((r) => {
        const on = +r.dataset.house === n;
        r.classList.toggle('on', on);
        r.setAttribute('aria-hidden', String(!on));
      });
    }
    function stop() { clearInterval(timer); timer = null; }

    houses.forEach((g) => {
      const n = +g.dataset.house;
      const pick = () => { stop(); show(n); mark(n); };
      // Hover previews; only a deliberate click or keyboard pick counts as read.
      g.addEventListener('mouseenter', () => { stop(); show(n); });
      g.addEventListener('focus', pick);
      g.addEventListener('click', pick);
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(); }
      });
    });

    show(current);
    // Walk the houses on its own until someone interacts, so the chart reads as alive.
    if (!reduce) {
      setTimeout(() => {
        if (!timer && current === 2) timer = setInterval(() => show((current % 12) + 1), 3400);
      }, 2600);
      root.addEventListener('pointerdown', stop, { once: true });
    }
  })();
</script>

<style>
  .kundli { margin: 0; display: grid; gap: 22px; justify-items: center; }
  .chart { width: min(100%, 480px); aspect-ratio: 1; }
  .paper { fill: rgb(22 27 64 / 0.72); }
  svg { width: 100%; height: 100%; overflow: visible; }

  .ink * {
    fill: none; stroke: var(--gold); stroke-width: 1.6; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 0;
    animation: draw 1.5s cubic-bezier(.6,.1,.3,1) backwards;
  }
  .ink path:nth-child(2) { animation-delay: 0.35s; }
  .ink path:nth-child(3) { animation-delay: 0.5s; }
  .ink path:nth-child(4) { animation-delay: 0.75s; }
  @keyframes draw { from { stroke-dashoffset: 1; } }

  .house { cursor: pointer; outline: none; }
  .house polygon { fill: transparent; transition: fill 0.35s; }
  .house:hover polygon { fill: rgb(242 181 68 / 0.1); }
  .house.on polygon { fill: rgb(242 181 68 / 0.2); }
  .house:focus-visible polygon { fill: var(--gold-soft); stroke: var(--text); stroke-width: 1.5; }
  .house text {
    text-anchor: middle;
    animation: appear 0.6s ease backwards; animation-delay: 1.5s;
  }
  .hn { font: 600 10px var(--display); fill: var(--gold); opacity: 0.85; }
  .hl { font: 600 13px var(--body); fill: #d3d5f0; transition: fill 0.3s; }
  .house:hover .hl { fill: #fff; }
  .house.on .hl { fill: #fff; font-weight: 750; }
  .house.on .hn { opacity: 1; }
  @media (max-width: 560px) {
    .hl { font-size: 14.5px; }
    .hn { font-size: 11px; }
  }
  @keyframes appear { from { opacity: 0; } }

  .reading { width: min(100%, 480px); }
  .stack { display: grid; border-left: 2px solid var(--gold); padding: 2px 0 2px 20px; }
  .read { grid-area: 1 / 1; visibility: hidden; opacity: 0; transition: opacity 0.25s; }
  .read.on { visibility: visible; opacity: 1; }
  .which { color: var(--gold); font-weight: 650; font-size: 0.9rem; margin-bottom: 6px; }
  .body { font-size: 1rem; }
  .m { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 4px 18px; font-weight: 700; font-size: 0.9rem; color: var(--teal); }
  .progress { margin-top: 20px; display: grid; gap: 8px; }
  .hint, .count { font-size: 0.85rem; }
  .pips { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .pips li { width: 10px; height: 10px; transform: rotate(45deg); border: 1.5px solid var(--line); transition: background-color 0.3s, border-color 0.3s; }
  .pips li.lit { background: var(--gold); border-color: var(--gold); }
  .done { margin-top: 14px; display: grid; gap: 12px; justify-items: start; animation: pop 0.5s cubic-bezier(.2,.9,.3,1.3); }
  @keyframes pop { from { opacity: 0; transform: scale(0.96); } }
  .complete .ink * { stroke-width: 2.4; filter: drop-shadow(0 0 6px rgb(242 181 68 / 0.7)); transition: stroke-width 0.6s; }

</style>
