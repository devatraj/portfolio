---
import Base from '../../layouts/Base.astro';
import { profile, orgLabel } from '../../lib/profile.js';

// Whole projects only; the milanSathi sub-facts live in its case study.
const IDS = [
  'milansathi', 'firebase-replacement', 'chat-suggestions', 'semantic-cache', 'genai-matchmaking',
  'structured-outputs', 'kafka-matching', 'conversion-pipelines', 'resume-tailor', 'ai-code-reviewer',
  'sutra', 'layout-optimizer', 'landing-page', 'otp-auth', 'api-aggregator', 'rabbitmq-refactor',
  'dna-methylation', 'my-mentor',
];
const byId = Object.fromEntries(profile.facts.map((f) => [f.id, f]));
const items = IDS.map((id) => byId[id]);
const FILTERS = [
  ['all', 'All'], ['cost', 'Cost savings'], ['ai', 'AI & LLMs'], ['backend', 'Backend & scale'], ['tools', 'Tools'], ['frontend', 'Frontend'],
];
const count = (k) => (k === 'all' ? items.length : items.filter((f) => f.kind.includes(k)).length);
const CASE = { milansathi: '/work/milansathi/' };
---
<Base title={`Work: ${profile.person.name}`} description="Everything I've built: cost savings, AI features, backend systems and tools." page="work">
  <section class="wrap top">
    <h1>Work</h1>
    <p class="lead dim">Everything I've built, at Jeevansathi, 99acres and on my own. Filter by what you care about, and open any project for the details.</p>
    <div class="filters" role="group" aria-label="Filter projects">
      {FILTERS.map(([k, label], i) => (
        <button type="button" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>
          {label} <span class="n num">{count(k)}</span>
        </button>
      ))}
    </div>
    <p class="showing dim" aria-live="polite" data-showing>Showing all {items.length}</p>
  </section>

  <section class="wrap">
    <ul class="grid" data-grid>
      {items.map((f) => (
        <li class="item" data-kind={f.kind.join(' ')}>
          <details>
            <summary>
              <span class="org">{orgLabel(f)}{f.credit === 'Contributed' && ', team project'}</span>
              <h2>{f.title}</h2>
              {f.metrics && <span class="hit">{f.metrics[0]}</span>}
              <span class="tags">{f.kind.map((k) => <i>{FILTERS.find(([x]) => x === k)?.[1]}</i>)}</span>
              <span class="open" aria-hidden="true"></span>
            </summary>
            <div class="body">
              <p>{f.text}</p>
              {f.metrics && f.metrics.length > 1 && <ul>{f.metrics.slice(1).map((m) => <li>{m}</li>)}</ul>}
              {CASE[f.id] && <a href={CASE[f.id]}>Read the case study</a>}
            </div>
          </details>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script is:inline>
  (() => {
    const btns = [...document.querySelectorAll('[data-filter]')];
    const items = [...document.querySelectorAll('[data-grid] .item')];
    const showing = document.querySelector('[data-showing]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    btns.forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.filter;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((it, i) => {
        const on = k === 'all' || it.dataset.kind.split(' ').includes(k);
        it.hidden = !on;
        if (on) {
          n++;
          if (!reduce) it.animate([{ opacity: 0, transform: 'scale(.97)' }, { opacity: 1, transform: 'none' }], { duration: 300, delay: Math.min(n, 10) * 30, easing: 'ease-out', fill: 'backwards' });
        }
      });
      showing.textContent = k === 'all' ? `Showing all ${n}` : `Showing ${n} of ${items.length}`;
    }));
  })();
</script>

<style>
  .top { padding-top: clamp(64px, 10vw, 128px); padding-bottom: 48px; display: grid; gap: 24px; }
  h1 { font-size: clamp(2.3rem, 6vw, 4.2rem); letter-spacing: -0.04em; }
  .lead { font-size: 1.15rem; max-width: 40rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .filters button {
    font: inherit; font-weight: 650; font-size: 0.92rem; cursor: pointer; color: var(--dim);
    background: transparent; border: 1.5px solid var(--line); border-radius: 999px; padding: 9px 16px;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .filters button:hover { color: var(--text); border-color: var(--gold); }
  .filters button[aria-pressed='true'] { background: var(--gold); border-color: var(--gold); color: var(--night); }
  .n { opacity: 0.7; margin-left: 4px; }
  .showing { font-size: 0.88rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 24px; align-items: start; }
  details { border: 1px solid var(--line); border-radius: 18px; background: var(--night-2); transition: border-color 0.25s; }
  details:hover, details[open] { border-color: var(--gold); }
  summary { list-style: none; cursor: pointer; padding: 26px 56px 26px 26px; display: grid; gap: 10px; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; border-radius: 18px; }
  .org { color: var(--gold); font-weight: 650; font-size: 0.85rem; }
  h2 { font-size: 1.1rem; font-weight: 600; letter-spacing: -0.01em; }
  .hit { color: var(--teal); font-weight: 650; font-size: 0.92rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags i { font-style: normal; font-size: 0.75rem; color: var(--dim); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; }
  .open { position: absolute; top: 26px; right: 22px; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--line); }
  .open::before, .open::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: var(--text); transform: translate(-50%, -50%); transition: transform 0.25s; }
  .open::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .open::after { transform: translate(-50%, -50%) rotate(0deg); }
  .body { padding: 0 26px 26px; display: grid; gap: 12px; color: var(--dim); }
  .body ul { margin: 0; padding-left: 1.1em; color: var(--teal); font-weight: 600; }
  .body a { font-weight: 650; color: var(--text); }
</style>
