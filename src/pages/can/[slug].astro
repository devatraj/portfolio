---
import Base from '../../layouts/Base.astro';
import CapNav from '../../components/CapNav.astro';
import BuildVsBuy from '../../components/tools/BuildVsBuy.astro';
import LlmCost from '../../components/tools/LlmCost.astro';
import KafkaSim from '../../components/tools/KafkaSim.astro';
import GunaMock from '../../components/GunaMock.astro';
import ConfigMock from '../../components/ConfigMock.astro';
import ChatSuggestMock from '../../components/ChatSuggestMock.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import { profile, factById as F, orgLabel } from '../../lib/profile.js';

export function getStaticPaths() {
  return profile.capabilities.map((c, i) => ({ params: { slug: c.slug }, props: { i } }));
}

const { i } = Astro.props;
const caps = profile.capabilities;
const c = caps[i];
const prev = caps[(i + caps.length - 1) % caps.length];
const next = caps[(i + 1) % caps.length];
const email = profile.person.email;

// Which hands-on pieces each page gets: a tool to try, and product demos beside the proof.
const TRY = { 'cut-costs': BuildVsBuy, 'llm-cost': LlmCost, scale: KafkaSim, 'ai-features': ChatSuggestMock, 'agents-tools': PhoneMock };
const DEMOS = {
  'cut-costs': [['milanSathi', GunaMock, 'Replaced a paid astrology API. Try another match.'], ['Config platform', ConfigMock, 'Replaced Firebase Remote Config. Drag the version, then fetch twice.']],
  scale: [['Config platform', ConfigMock, 'First matching rule wins, served from Redis, 304 when nothing changed.']],
  'ai-features': [['milanSathi', GunaMock, 'AI conversation starters grounded in both charts.']],
};
const Try = TRY[c.slug];
const demos = DEMOS[c.slug] ?? [];
const CASE = { milansathi: '/work/milansathi/' };
---
<Base title={`${c.title}: ${profile.person.name}`} description={c.promise} page="can" cap={c.slug}>
  <CapNav current={c.slug} />

  <section class="wrap top">
    <p class="eyebrow">What I do, <span class="num">{i + 1}</span> of <span class="num">{caps.length}</span></p>
    <h1>{c.title}</h1>
    <p class="promise">{c.promise}</p>
    <div class="meta">
      <div class="metric"><b class="num" data-count>{c.headline_metric[0]}</b><span>{c.headline_metric[1]}</span></div>
      <p class="for"><span class="dim">Who it's for:</span> {c.for}</p>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>The problem</h2>
    </div>
    <ul class="problems">
      {c.problems.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="wrap section" id="try">
    <div class="section-head">
      <h2>Try it</h2>
      <p>{Try === ChatSuggestMock ? 'A feature I shipped, rebuilt as a demo. Pick a suggestion and send it.' : Try === PhoneMock ? 'resume-tailor, one of my own tools. Switch the job post.' : 'A small working tool. Change the numbers.'}</p>
    </div>
    <div class:list={['try', { narrow: Try === ChatSuggestMock || Try === PhoneMock }]}>
      <Try />
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Where I've done it</h2>
    </div>
    <div class="proof">
      {c.proof.map((id) => {
        const f = F[id];
        return (
          <article class="card">
            <p class="org">{orgLabel(f)}{f.credit === 'Contributed' && ', team project'}</p>
            <h3>{f.title}</h3>
            <p class="dim">{f.text}</p>
            {f.metrics && <ul class="m">{f.metrics.map((m) => <li>{m}</li>)}</ul>}
            {CASE[id] && <a class="more" href={CASE[id]}>Read the case study</a>}
          </article>
        );
      })}
    </div>
    {demos.length > 0 && (
      <div class="demos">
        {demos.map(([name, Demo, cap]) => (
          <figure>
            <div class="tilt" data-tilt><Demo /></div>
            <figcaption><b>{name}.</b> <span class="dim">{cap}</span></figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>How I'd do it for you</h2>
    </div>
    <ol class="steps">
      {c.steps.map((s) => <li><h3>{s.title}</h3><p class="dim">{s.text}</p></li>)}
    </ol>
  </section>

  <section class="wrap section">
    <div class="ask">
      <h2>Need this?</h2>
      <p class="dim">Tell me what you're working with. I'll tell you honestly whether it's worth doing and roughly what it takes.</p>
      <a class="btn solid" href={`mailto:${email}?subject=${encodeURIComponent(c.title)}`}>Email me about this</a>
    </div>
  </section>

  <nav class="wrap pager" aria-label="More of what I do">
    <a href={`/can/${prev.slug}/`} class="prev"><span class="dim">Previous</span><b>{prev.title}</b></a>
    <a href={`/can/${next.slug}/`} class="next"><span class="dim">Next</span><b>{next.title}</b></a>
  </nav>
</Base>

<style>
  .top { padding-top: clamp(64px, 10vw, 128px); display: grid; gap: 24px; }
  h1 { font-size: clamp(2.2rem, 5.6vw, 4rem); letter-spacing: -0.04em; line-height: 1.02; max-width: 16ch; }
  .promise { font-size: clamp(1.15rem, 2.2vw, 1.4rem); max-width: 40rem; color: var(--text); line-height: 1.5; }
  .meta { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center; margin-top: 24px; padding-top: 32px; border-top: 1px solid var(--line); }
  .metric { display: grid; gap: 4px; }
  .metric b { font: 600 clamp(2.1rem, 4.4vw, 3rem) var(--display); color: var(--gold); letter-spacing: -0.03em; line-height: 1; }
  .metric span { color: var(--dim); }
  .for { max-width: 28rem; }

  .problems { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 20px; }
  .problems li { padding: 24px; border-radius: 16px; background: var(--night-2); border: 1px solid var(--line); font-size: 1.05rem; }

  .try.narrow { max-width: 420px; }

  .proof { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; }
  .card { padding: 28px; border-radius: 18px; border: 1px solid var(--line); display: grid; gap: 12px; align-content: start; transition: border-color 0.25s; }
  .card:hover { border-color: var(--gold); }
  .org { color: var(--gold); font-weight: 650; font-size: 0.85rem; }
  .card h3 { font-size: 1.08rem; }
  .card .dim { font-size: 0.95rem; }
  .m { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 4px; color: var(--teal); font-weight: 650; font-size: 0.9rem; }
  .more { font-weight: 650; font-size: 0.92rem; }

  .demos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; margin-top: var(--space-block); align-items: start; }
  figure { margin: 0; display: grid; gap: 16px; }
  figcaption { font-size: 0.92rem; }
  .tilt { transition: transform 0.25s ease-out; }

  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 32px; }
  .steps li { counter-increment: s; display: grid; gap: 10px; align-content: start; padding-top: 20px; border-top: 2px solid var(--line); }
  .steps li::before { content: counter(s); font: 600 1.4rem var(--display); color: var(--gold); }

  .ask {
    display: grid; gap: 18px; justify-items: start; padding: clamp(32px, 6vw, 64px); border-radius: var(--radius-lg);
    background: radial-gradient(120% 140% at 100% 0%, rgb(242 181 68 / 0.16), transparent 55%), var(--night-2);
    border: 1px solid var(--line);
  }
  .ask p { max-width: 36rem; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-top: var(--space-block); }
  .pager a { display: grid; gap: 6px; padding: 24px 28px; border-radius: 18px; border: 1px solid var(--line); text-decoration: none; transition: border-color 0.2s; }
  .pager a:hover { border-color: var(--gold); color: inherit; }
  .pager b { font: 600 1.1rem var(--display); }
  .next { text-align: right; }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .next { text-align: left; }
  }
</style>
